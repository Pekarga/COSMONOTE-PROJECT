# Copie ce fichier en .env.local puis remplis ce dont tu as besoin.
# Sans clé, l'appli tourne en mode démo (transcription et notes d'exemple).

# Clé Anthropic : active la génération des notes et l'assistant avec Claude.
ANTHROPIC_API_KEY=

# Clé Deepgram : active la vraie transcription avec identification des intervenants.
DEEPGRAM_API_KEY=

# Langue de transcription (code Deepgram, par ex. fr, en, es, ou multi).
TRANSCRIPTION_LANGUAGE=fr

# Mot de passe facultatif pour protéger l'appli (utile si tu la mets en ligne).
APP_PASSWORD=

# Dossier où sont stockées la base et les fichiers (par défaut ./data).
DATA_DIR=
