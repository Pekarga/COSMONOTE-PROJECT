# Copiez ce fichier en .env.local puis remplissez ce dont vous avez besoin.
# Sans clé, l'application tourne en mode démo (règles simples, sans IA).

# Clé Anthropic : active l'analyse des dossiers et la rédaction avec Claude.
ANTHROPIC_API_KEY=

# Mot de passe facultatif pour protéger l'application (utile si elle est en ligne).
APP_PASSWORD=

# Dossier où sont stockées la base et les fichiers (par défaut ./data).
DATA_DIR=
