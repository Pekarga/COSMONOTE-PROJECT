{
  "name": "le-redacteur",
  "version": "0.3.3",
  "private": true,
  "description": "Le rédacteur : rédige vos courriers administratifs et vos notes au Directeur dans le style de vos courriers signés.",
  "scripts": {
    "dev": "node scripts/copier-ocr.mjs && next dev",
    "build": "node scripts/copier-ocr.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "desktop:prepare": "node scripts/prepare-desktop.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "docx": "^9.6.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.13.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^2.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tesseract.js-data/fra": "1.0.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "pdfjs-dist": "6.5.438",
    "tesseract.js": "7.0.0",
    "typescript": "^5.9.3"
  }
}
